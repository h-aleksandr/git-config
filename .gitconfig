[user]
	email = alexandrgaiko88@gmail.com
	name = a-haiko

[core]
    editor = code --wait
    # Linux/macOS:
    autocrlf = input
    # Windows:
    # autocrlf = true
    # Linux/macOS (~ раскрывается в домашнюю папку):
    excludesfile = ~/.gitignore_global
    # Windows (полный путь, слэши прямые, иначе нужно экранировать обратные):
    # excludesfile = C:/Users/ИМЯ/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[commit]
    verbose = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change

[rerere]
    enabled = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[help]
    autocorrect = prompt

[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = lg --all
    undo = reset --soft HEAD~1
    unstage = restore --staged --
    wip = !git add -A && git commit -m \"WIP\"